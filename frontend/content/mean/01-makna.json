        { "key": "sum", "text": "Kumpulkan semua kelereng: 3 + 5 + 6 + 2 = 16.", "value": 16 },
        { "key": "divide", "text": "Bagi sama rata: 16 : 4 = 4.", "value": 4 },
        { "key": "interpret", "text": "Jadi, rata-rata kelereng setiap anak adalah 4." }
      ]
