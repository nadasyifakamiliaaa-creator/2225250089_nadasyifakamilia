# Contoh variabel lingkungan untuk server RataKu (docs/09).
# Salin nilai-nilai ini ke pengaturan "Environment" di layanan hosting. JANGAN commit berkas .env asli.

# Lokasi basis data SQLite. Saat deploy WAJIB diarahkan ke penyimpanan permanen (volume/disk),
# kalau tidak, data penelitian hilang setiap server dimulai ulang.
DATABASE_PATH=/data/rataku.db

# Isi bila aplikasi siswa di-hosting di domain lain (docs/09 opsi C), pisahkan dengan koma.
ALLOWED_ORIGINS=

# Cookie dasbor guru: "auto" (Secure bila HTTPS), "true", atau "false".
COOKIE_SECURE=auto
